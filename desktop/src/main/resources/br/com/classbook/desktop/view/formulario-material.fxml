<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>

<!-- Campos do material digital (Issue #58); a lista de disciplinas vem da API. -->
<GridPane hgap="8" vgap="8" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="br.com.classbook.desktop.view.FormularioMaterialController">
	<columnConstraints>
		<ColumnConstraints minWidth="140"/>
		<ColumnConstraints prefWidth="340" hgrow="ALWAYS"/>
	</columnConstraints>
	<Label text="Título *" GridPane.rowIndex="0"/>
	<TextField fx:id="titulo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
	<Label text="Formato *" GridPane.rowIndex="1"/>
	<ComboBox fx:id="formato" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
	<Label text="URL *" GridPane.rowIndex="2"/>
	<TextField fx:id="url" promptText="https://..." GridPane.columnIndex="1" GridPane.rowIndex="2"/>
	<Label text="Disciplina *" GridPane.rowIndex="3"/>
	<ComboBox fx:id="disciplina" maxWidth="Infinity" promptText="Carregando..." GridPane.columnIndex="1"
		GridPane.rowIndex="3"/>
	<Label text="Data de publicação" GridPane.rowIndex="4"/>
	<TextField fx:id="dataPublicacao" promptText="dd/mm/aaaa" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
	<Label text="Descrição" GridPane.rowIndex="5"/>
	<TextArea fx:id="descricao" prefRowCount="3" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
</GridPane>
