<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Tela de catálogo de livros (Issue #56): lista GET /api/livros. Busca e filtros são da Issue #57. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="16"
	fx:controller="br.com.classbook.desktop.view.CatalogoLivrosController">
	<VBox styleClass="cabecalho-pagina" spacing="2">
		<Label text="Catálogo de Livros" styleClass="titulo"/>
		<Label fx:id="subtitulo" text="Carregando livros..." styleClass="subtitulo"/>
		<Label fx:id="aviso" styleClass="subtitulo" wrapText="true"/>
	</VBox>
	<HBox styleClass="barra-de-acoes">
		<Button text="Novo livro" onAction="#novo"/>
		<Button fx:id="editar" text="Editar" onAction="#editar"/>
		<Button fx:id="excluir" text="Excluir" onAction="#excluir"/>
		<Button text="Atualizar" onAction="#atualizar"/>
	</HBox>
	<VBox styleClass="cartao" VBox.vgrow="ALWAYS">
		<TableView fx:id="tabela" VBox.vgrow="ALWAYS">
			<placeholder>
				<Label fx:id="mensagemVazia" text="Carregando livros..." styleClass="mensagem-vazia"/>
			</placeholder>
			<columns>
				<TableColumn fx:id="colunaTitulo" text="Título" prefWidth="280"/>
				<TableColumn fx:id="colunaAutor" text="Autor" prefWidth="200"/>
				<TableColumn fx:id="colunaCategoria" text="Categoria" prefWidth="160"/>
				<TableColumn fx:id="colunaAno" text="Ano" prefWidth="80"/>
			</columns>
		</TableView>
	</VBox>
</VBox>
