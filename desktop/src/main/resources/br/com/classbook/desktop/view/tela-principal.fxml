<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Tela principal e navegação (Issue #55): menu à esquerda troca o conteúdo de areaConteudo. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefWidth="960"
	prefHeight="640" fx:id="raiz" fx:controller="br.com.classbook.desktop.view.TelaPrincipalController">
	<left>
		<VBox styleClass="sidebar" fx:id="menu">
			<HBox styleClass="marca" alignment="CENTER_LEFT">
				<StackPane styleClass="marca-selo">
					<SVGPath styleClass="marca-icone"
						content="M3 5.2C5 4.1 8 4 11 5.4V18.8C8 17.4 5 17.5 3 18.6V5.2Z M21 5.2C19 4.1 16 4 13 5.4V18.8C16 17.4 19 17.5 21 18.6V5.2Z"/>
				</StackPane>
				<VBox>
					<Label text="ClassBook" styleClass="marca-nome"/>
					<Label text="BIBLIOTECA DIGITAL" styleClass="marca-tagline"/>
				</VBox>
			</HBox>
			<Button fx:id="botaoCatalogo" text="Catálogo de livros" maxWidth="Infinity" styleClass="nav-item"
				onAction="#mostrarCatalogo"/>
			<Button fx:id="botaoAutores" text="Autores" maxWidth="Infinity" styleClass="nav-item"
				onAction="#mostrarAutores"/>
			<Button fx:id="botaoCategorias" text="Categorias" maxWidth="Infinity" styleClass="nav-item"
				onAction="#mostrarCategorias"/>
			<Button fx:id="botaoDisciplinas" text="Disciplinas" maxWidth="Infinity" styleClass="nav-item"
				onAction="#mostrarDisciplinas"/>
			<Button fx:id="botaoMateriais" text="Materiais digitais" maxWidth="Infinity" styleClass="nav-item"
				onAction="#mostrarMateriais"/>
		</VBox>
	</left>
	<center>
		<StackPane fx:id="areaConteudo" styleClass="area-conteudo">
			<Label text="Selecione uma seção no menu." styleClass="mensagem-vazia"/>
		</StackPane>
	</center>
</BorderPane>
