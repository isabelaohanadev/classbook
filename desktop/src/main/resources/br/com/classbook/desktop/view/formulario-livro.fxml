<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<!-- Campos do livro (Issue #58); as listas de autor, categoria e disciplina vêm da API. -->
<GridPane hgap="8" vgap="8" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="br.com.classbook.desktop.view.FormularioLivroController">
	<columnConstraints>
		<ColumnConstraints minWidth="140"/>
		<ColumnConstraints prefWidth="340" hgrow="ALWAYS"/>
	</columnConstraints>
	<Label text="Título *" GridPane.rowIndex="0"/>
	<TextField fx:id="titulo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
	<Label text="ISBN *" GridPane.rowIndex="1"/>
	<TextField fx:id="isbn" promptText="10 ou 13 dígitos; hífens são aceitos" GridPane.columnIndex="1"
		GridPane.rowIndex="1"/>
	<Label text="Autor *" GridPane.rowIndex="2"/>
	<ComboBox fx:id="autor" maxWidth="Infinity" promptText="Carregando..." GridPane.columnIndex="1"
		GridPane.rowIndex="2"/>
	<Label text="Categoria" GridPane.rowIndex="3"/>
	<HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="3">
		<ComboBox fx:id="categoria" maxWidth="Infinity" promptText="Sem categoria" HBox.hgrow="ALWAYS"/>
		<Button text="Limpar" onAction="#limparCategoria"/>
	</HBox>
	<Label text="Disciplina" GridPane.rowIndex="4"/>
	<HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="4">
		<ComboBox fx:id="disciplina" maxWidth="Infinity" promptText="Sem disciplina" HBox.hgrow="ALWAYS"/>
		<Button text="Limpar" onAction="#limparDisciplina"/>
	</HBox>
	<Label text="Ano de publicação" GridPane.rowIndex="5"/>
	<TextField fx:id="anoPublicacao" promptText="por exemplo, 1899" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
	<Label text="Editora" GridPane.rowIndex="6"/>
	<TextField fx:id="editora" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
	<Label text="Descrição" GridPane.rowIndex="7"/>
	<TextArea fx:id="descricao" prefRowCount="3" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
</GridPane>
