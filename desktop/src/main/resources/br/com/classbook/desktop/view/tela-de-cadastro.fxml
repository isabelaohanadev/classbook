<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Lista de um recurso com os botões de cadastro (Issues #58 e #61); o TelaDeCadastroController põe as
	colunas. Mesmo layout do catálogo de livros: cabeçalho, ações e a tabela num cartão. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="16"
	fx:controller="br.com.classbook.desktop.view.TelaDeCadastroController">
	<VBox styleClass="cabecalho-pagina" spacing="2">
		<Label fx:id="titulo" styleClass="titulo"/>
		<Label fx:id="aviso" styleClass="subtitulo" wrapText="true"/>
	</VBox>
	<HBox styleClass="barra-de-acoes">
		<Button text="Novo" onAction="#novo"/>
		<Button fx:id="editar" text="Editar" onAction="#editar"/>
		<Button fx:id="excluir" text="Excluir" onAction="#excluir"/>
		<Button text="Atualizar" onAction="#atualizar"/>
	</HBox>
	<VBox styleClass="cartao" VBox.vgrow="ALWAYS">
		<TableView fx:id="tabela" VBox.vgrow="ALWAYS">
			<placeholder>
				<Label fx:id="mensagemVazia" text="Carregando..." styleClass="mensagem-vazia"/>
			</placeholder>
			<columnResizePolicy>
				<TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
			</columnResizePolicy>
		</TableView>
	</VBox>
</VBox>
